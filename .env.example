# ==============================================================================
# POLYSEER - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# APP CONFIGURATION
# ------------------------------------------------------------------------------
# Set to 'self-hosted' or 'valyu'
# self-hosted = no auth, your own Valyu API key pays for research (RECOMMENDED)
# valyu = Sign in with Valyu, research billed to each user's Valyu credits
NEXT_PUBLIC_APP_MODE=self-hosted

# Your app URL (use http://localhost:3000 for local development).
# Completion emails deep-link to NEXT_PUBLIC_APP_URL/research/{id}, which must be https.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# VALYU API (REQUIRED IN SELF-HOSTED MODE)
# ------------------------------------------------------------------------------
# Server-side API key. Every forecast is a Valyu DeepResearch task billed to
# this key: about $0.10 (Low) to $15 (XHigh) per run, plus $0.10 for the
# second deliverable file.
# Get your API key at: https://platform.valyu.ai
VALYU_API_KEY=valyu_your_api_key_here

# Optional: email an address in your Valyu organisation when research finishes.
# The email links back to the forecast page in this app.
# DEEPRESEARCH_ALERT_EMAIL=you@example.com

# ==============================================================================
# SELF-HOSTED MODE (RECOMMENDED)
# ==============================================================================
# Self-hosted mode is the easiest way to run Polyseer locally:
# - No authentication required
# - Local SQLite database (automatically created)
# - Research history comes straight from your Valyu account
#
# Just set these 2 variables and you're ready to go:
#   NEXT_PUBLIC_APP_MODE=self-hosted
#   VALYU_API_KEY=valyu_xxx
# ==============================================================================

# ==============================================================================
# VALYU MODE (Advanced - OAuth Required)
# ==============================================================================
# Valyu OAuth apps will be in general availability soon.
# Currently client id/secret are not publicly available.
# Contact contact@valyu.ai if you need access.
#
# Valyu mode provides:
# - Sign in with Valyu OAuth
# - Research billed to each user's Valyu organisation credits
# - Completion emails sent to the signed-in user
# ------------------------------------------------------------------------------

# Valyu Platform's Supabase URL (for OAuth endpoints: /auth/v1/oauth/authorize, /auth/v1/oauth/token)
# NEXT_PUBLIC_VALYU_SUPABASE_URL=https://xxx.supabase.co

# Valyu Platform URL (for platform endpoints: /api/oauth/userinfo, /api/oauth/proxy)
# VALYU_APP_URL=https://platform.valyu.ai

# OAuth Client ID (safe for client-side)
# NEXT_PUBLIC_VALYU_CLIENT_ID=your-oauth-client-id

# OAuth Client Secret (SERVER ONLY - never expose client-side)
# VALYU_CLIENT_SECRET=your-oauth-client-secret

# ------------------------------------------------------------------------------
# SUPABASE (REQUIRED FOR VALYU MODE ONLY)
# ------------------------------------------------------------------------------
# App's own Supabase for user accounts.
# Only needed when NEXT_PUBLIC_APP_MODE=valyu
# Get these from: https://supabase.com -> Project Settings -> API

# Your Supabase project URL
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (public) key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role key (KEEP SECRET - never expose client-side)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==============================================================================
# QUICK START EXAMPLES
# ==============================================================================

# Self-Hosted Mode (Easy Setup - No Auth - RECOMMENDED):
# NEXT_PUBLIC_APP_MODE=self-hosted
# VALYU_API_KEY=valyu_xxx

# Valyu Mode (Full Setup - OAuth - Contact contact@valyu.ai for access):
# NEXT_PUBLIC_APP_MODE=valyu
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
# NEXT_PUBLIC_VALYU_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_VALYU_CLIENT_ID=your-oauth-client-id
# VALYU_CLIENT_SECRET=your-oauth-client-secret
# VALYU_APP_URL=https://platform.valyu.ai
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
# SUPABASE_SERVICE_ROLE_KEY=xxx
